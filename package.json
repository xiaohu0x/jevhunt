{
  "name": "jevhunt",
  "version": "0.3.0",
  "private": true,
  "description": "JevHunt — a static directory with bounded daily catalog updates",
  "scripts": {
    "build": "node tools/check-project-content.mjs --ledger-only && node tools/build-project-content.mjs && node tools/build-browser-catalog.mjs && node tools/prerender-catalog.mjs && node tools/localize.mjs && node tools/build-directory.mjs && node tools/build-editorial.mjs && node tools/build-static.mjs && node tools/stamp.mjs && node tools/build-manifest.mjs",
    "catalog:sync": "node tools/sync-daily.mjs",
    "audit:project-seo": "node tools/audit-project-seo.mjs",
    "content:collect": "node tools/collect-project-sources.mjs",
    "content:sources:restore": "node tools/restore-project-sources.mjs",
    "content:check": "node tools/check-project-content.mjs",
    "content:verify:static": "node tools/verify-project-content.mjs --static",
    "content:verify:production": "node tools/verify-project-content.mjs",
    "content:publish:local": "node tools/publish-project-content.mjs --apply",
    "test": "node --test tools/*.test.mjs",
    "dev": "node tools/dev-static.mjs",
    "deploy": "npm run build && npm test && npm run check:static && node tools/deploy-static.mjs && npm run verify:production",
    "db:migrate:local": "wrangler d1 migrations apply jevhunt-db --local",
    "test:examples": "python3 tools/test-examples.py && python3 tools/test-editorial-example.py",
    "verify:production": "node tools/verify-deploy.mjs https://jevhunt.com",
    "catalog:seed:local": "node tools/seed-catalog.mjs",
    "check:static": "node tools/check-static.mjs",
    "deploy:check": "node tools/deploy-static.mjs --dry-run",
    "retire:worker": "wrangler deploy --config workers/catalog-sync/wrangler.toml"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "wrangler": "^4.84.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
